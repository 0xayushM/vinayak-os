# ── Vinayak Brain OS — environment variables ─────────────────────────────────
# Copy this file to .env.local (Next.js) or .env (Python) and fill in real values.
# NEVER commit .env or .env.local to git.

# ── Python (FastAPI + pipelines) ────────────────────────────────────────────

# TranzAct API endpoints (infrastructure URLs — not credentials)
# Credentials are stored encrypted per brand in the DB via the dashboard UI.
TRANZACT_BASE_URL=https://be.letstranzact.com
TRANZACT_REPORTING_URL=https://reporting.letstranzact.com

# Postgres connection string
# Supabase (recommended): Settings → Database → Connection string → URI → Direct (port 5432)
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Local dev:
#   postgresql://postgres:postgres@localhost:5432/vinayak_brain
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Dev mode — relaxes fail-hard security checks for LOCAL DEV ONLY:
# allows missing JWT_SECRET (random ephemeral one is used), missing
# INTERNAL_API_KEY, and localhost CORS origins. NEVER set in production.
# VINAYAK_DEV_MODE=1

# Platform JWT secret — REQUIRED (startup fails without it, unless dev mode).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme

# Admin credentials are stored in the DB (NOT in env).
# Create your admin user by running once after setup:
#   python -m vinayak.scripts.setup_db

# AES-256 Fernet key for encrypting stored ERP credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Internal API key shared between Next.js BFF and FastAPI — REQUIRED
# (startup fails without it, unless dev mode).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=changeme

# Rate limiting (stay under TranzAct's 10 req/min/machine limit)
TRANZACT_REQUESTS_PER_MINUTE=8

# Staleness alert threshold in hours
SYNC_STALENESS_HOURS=25

# ── Background work: the worker, its heartbeat, and alerts ───────────────────
# Production runs two services from one image (see Procfile):
#   web    — uvicorn, RUN_SCHEDULER UNSET (a scheduler here runs every job
#            again, once per API replica)
#   worker — python -m vinayak.worker (railway.worker.json), same variables
# Local dev without a worker process: set RUN_SCHEDULER=1 on the API.
# RUN_SCHEDULER=1

# Where alerts go when a sync fails, a watcher halts, the morning brief reaches
# nobody, or the worker stops beating. Comma-separated. Needs the email
# provider below. Unset → alerts are only logged (at ERROR) and shown on the
# Sync page — set it in production, on BOTH services.
ALERT_EMAIL=
# A condition that persists is emailed at most once per this many hours.
# ALERT_COOLDOWN_HOURS=6
# The worker beats every minute; the API calls it down after this many
# minutes without one.
# HEARTBEAT_STALE_MINUTES=5
# The API runs the worker-down check. Set 0 only where no worker is expected.
# WORKER_WATCHDOG=1
# Optional stable name for a scheduler's heartbeat row (defaults to the
# Railway replica id, else hostname).
# WORKER_ID=
# Brain tick interval (worker).
# BRAIN_TICK_MINUTES=10

# Email provider — used by alerts, the morning brief and approved chases.
# Resend wins if both are set. Needed on the worker (brief, alerts) and the
# API (approved sends, worker-down alerts).
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM="BIDE <no-reply@example.com>"

# Logs: human-readable by default; `json` for one JSON object per line. Every
# API line carries req=<X-Request-ID> and ws=<workspace>.
# LOG_FORMAT=json

# ── Claude / Anthropic (optional — turns on the AI reasoning layer) ──────────
# Get a key from console.anthropic.com. When set, Claude routes unrecognised
# questions and phrases answers (numbers stay deterministic + validated either way).
# Leave blank to run the reasoning engine deterministically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Next.js (BFF) ─────────────────────────────────────────────────────────────

# FastAPI private URL — server-to-server only, NEVER exposed to the browser.
# Local dev: http://localhost:8000. In production set this to wherever the
# FastAPI service runs (it is read only in server-side route handlers).
FASTAPI_INTERNAL_URL=http://localhost:8000

# Same internal API key as above — server-side only, not NEXT_PUBLIC_
INTERNAL_API_KEY=changeme

# Public app URL (Vercel deployment URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Set these to flip auth from the legacy custom JWT to Supabase. Until
# SUPABASE_JWT_SECRET is set, the backend uses the legacy email+password path.
# Find them in Supabase dashboard → Project Settings → API (and → API → JWT).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# REQUIRED in apps/web/.env.local — the browser client, proxy.ts session gate and
# the BFF Bearer forwarding all read these (same values as the two above):
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   FASTAPI_INTERNAL_URL=
#   INTERNAL_API_KEY=
